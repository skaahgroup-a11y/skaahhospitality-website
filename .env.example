# Maintained per docs/07 section "Environment variables". Server .env is the
# single runtime secret store (docs/08 S6). All values here are examples only.

# Absolute base URL of the deployment (no trailing slash)
SITE_URL=https://skaahhospitality.com

# staging | production. Staging renders [TO CONFIRM] markers with an amber
# badge; production builds are blocked while any remain (CLAUDE.md, gate G5).
NEXT_PUBLIC_ENV=staging

# Directory for runtime data: enquiry payloads, uploads, reference counter.
# On Hostpoint this is ~/app/skaah-web/shared/data (docs/08 S3).
DATA_DIR=./data

# Transactional mail via authenticated Hostpoint SMTP (docs/05 S8). Delivery
# is skipped and logged when unset (local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@skaahhospitality.com

# Per-segment delivery mailboxes as JSON. [TO CONFIRM: final addresses]
SEGMENT_MAILBOXES={"delegation":"delegations@skaahhospitality.com","mice":"mice@skaahhospitality.com","stay":"stays@skaahhospitality.com","catering":"catering@skaahhospitality.com","agency":"partners@skaahhospitality.com","general":"enquiry@skaahhospitality.com"}

# Tracking sheet webhook (Google Sheets API); CSV-by-mail interim when unset.
SHEET_WEBHOOK_URL=

# Analytics: Plausible (EU-hosted) primary; GA4 optional behind consent.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=

# WhatsApp number in international format without +. [TO CONFIRM: number]
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Phone number for tel: links. [TO CONFIRM: number]
NEXT_PUBLIC_PHONE_NUMBER=

# Video provider (Mux EU-pinned or Cloudflare Stream), wired in E-media.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
